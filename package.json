{
  "name": "revit-mcp",
  "version": "1.0.0",
  "description": "Advanced MCP server for Revit automation with 65+ tools for AI-driven BIM drafting, furniture layout, design analysis, and building code compliance",
  "main": "index.js",
  "type": "module",
  "bin": {
    "revit-mcp": "./build/index.js"
  },
  "scripts": {
    "clean": "rimraf build",
    "prebuild": "npm run clean",
    "build": "tsc",
    "test": "npm run build && node scripts/validate-local-runtime-contracts.mjs && npm run test:local-gateway && node --test build/tools/contracts.test.js build/relay/relay-session.test.js scripts/claude-proxy.test.mjs scripts/validate-local-tool-catalog.test.mjs && npm run test:policy-bundle && npm run verify:verify-only-canary && npm run test:verify-only-canary",
    "test:local-gateway": "node --test build/policy/local-tool-policy.test.js build/policy/signed-policy.test.js build/local-gateway/config.test.js build/local-gateway/framed-stdio.test.js build/local-gateway/manifest-loader.test.js build/local-gateway/gateway.test.js build/local-gateway/mcp-server.test.js",
    "contracts:v2:generate": "npm run build && node scripts/generate-local-tool-policy.mjs",
    "contracts:v2:catalog:validate": "node scripts/validate-local-tool-catalog.mjs",
    "contracts:v2:fixtures": "node scripts/update-local-runtime-fixtures.mjs",
    "contracts:v2:validate": "npm run build && node scripts/validate-local-runtime-contracts.mjs",
    "test:policy-bundle": "node --test scripts/policy-bundle-canonical.test.mjs",
    "build:verify-only-canary": "npm run build && node scripts/build-verify-only-canary.mjs",
    "verify:verify-only-canary": "node scripts/verify-verify-only-canary.mjs",
    "test:verify-only-canary": "node --test build/canary/verify-only.test.js scripts/verify-only-canary-artifact.test.mjs",
    "start:local-gateway": "node build/local-gateway/entrypoint.js",
    "start": "node --env-file=.env build/server-combined.js",
    "start:stdio": "node --env-file=.env build/index.js",
    "start:relay": "node --env-file=.env build/relay/relay-server.js",
    "start:all": "node --env-file=.env build/server-combined.js",
    "start:secure": "node server-secure.cjs"
  },
  "files": [
    "build",
    "!build/**/*.test.js",
    "!build/test-support",
    "contracts/desktop-bridge/v2/trust-root.v1.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RAJ-IITROORKEE/Revit-mcp-datum.git"
  },
  "keywords": [
    "revit",
    "mcp",
    "automation",
    "bim",
    "drafting",
    "ai"
  ],
  "author": "Raj Rabidas @Datum",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RAJ-IITROORKEE/Revit-mcp-datum/issues"
  },
  "homepage": "https://github.com/RAJ-IITROORKEE/Revit-mcp-datum#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.1",
    "better-sqlite3": "^11.7.0",
    "canonicalize": "^2.1.0",
    "express": "^5.2.1",
    "pino": "^9.4.0",
    "ws": "^8.18.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "0.25.8",
    "rimraf": "^5.0.10",
    "typescript": "^5.8.2"
  }
}
