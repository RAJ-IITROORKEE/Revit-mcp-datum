{
  "name": "revit-mcp",
  "version": "1.0.0",
  "description": "Advanced MCP server for Revit automation with 65+ tools for AI-driven BIM drafting, furniture layout, design analysis, and building code compliance",
  "main": "index.js",
  "type": "module",
  "bin": {
    "revit-mcp": "./build/index.js"
  },
  "scripts": {
    "clean": "rimraf build",
    "prebuild": "npm run clean",
    "build": "tsc || exit 0",
    "start": "node build/server-http.js",
    "start:stdio": "node build/index.js",
    "start:secure": "node server-secure.js"
  },
  "files": [
    "build"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RAJ-IITROORKEE/Revit-mcp-datum.git"
  },
  "keywords": [
    "revit",
    "mcp",
    "automation",
    "bim",
    "drafting",
    "ai"
  ],
  "author": "Raj Rabidas @Datum",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RAJ-IITROORKEE/Revit-mcp-datum/issues"
  },
  "homepage": "https://github.com/RAJ-IITROORKEE/Revit-mcp-datum#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.1",
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.0",
    "ws": "^8.18.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "rimraf": "^5.0.10",
    "typescript": "^5.8.2"
  }
}
