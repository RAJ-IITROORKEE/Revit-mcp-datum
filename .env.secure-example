# Revit MCP Server - Secure Configuration Example

# ========== PORT & HOST ==========
# Port to run the HTTPS server on
MCP_PORT=3000

# Host to bind to
# - 127.0.0.1 = localhost only (RECOMMENDED for security)
# - 0.0.0.0 = all interfaces (ONLY if behind proper firewall)
MCP_HOST=127.0.0.1

# ========== CERTIFICATES ==========
# Path to SSL certificate file (use Let's Encrypt in production)
CERT_PATH=./certs/server.crt

# Path to SSL key file
KEY_PATH=./certs/server.key

# ========== ENVIRONMENT ==========
# development or production
NODE_ENV=production

# ========== SECURITY - API KEY AUTHENTICATION ==========
# REQUIRED: Strong API key for securing your server
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters - Keep this SECRET!
MCP_API_KEY=your-super-secret-key-minimum-32-characters-here

# ========== SECURITY - IP WHITELIST ==========
# Enable IP whitelist to restrict access to specific IPs
# Set to "true" to enable, "false" to disable
ENABLE_IP_WHITELIST=false

# Comma-separated list of allowed IPs
# Example: 192.168.1.100,10.0.0.50,203.0.113.0/24
# Localhost (127.0.0.1) is ALWAYS allowed
WHITELIST_IPS=192.168.1.0/24

# ========== SECURITY - RATE LIMITING ==========
# Enable rate limiting to prevent brute force attacks and DoS
# Set to "true" to enable, "false" to disable
ENABLE_RATE_LIMIT=true

# Maximum number of requests per time window
RATE_LIMIT_REQUESTS=100

# Time window in milliseconds (60000 = 1 minute)
RATE_LIMIT_WINDOW=60000

# ========== OPTIONAL FIELDS ==========
# Domain name (for reference only)
MCP_DOMAIN=your-domain.com

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ========== CONNECTION MODE ==========
# CRITICAL for Railway/cloud deployment: set to "relay" so MCP tool calls route through
# the cloud relay WebSocket to the Revit plugin, instead of trying to connect to localhost:8080.
# Without this, all Revit tool executions fail silently in production.
# Options: "relay" (cloud/Railway) | "direct" (local dev with Revit on same machine)
REVIT_CONNECTION_MODE=relay

# ========== SECURITY NOTES ==========
# 1. NEVER commit this file to git - add to .gitignore
# 2. Rotate API_KEY every 90 days
# 3. For production, use Let's Encrypt certificates
# 4. Monitor logs for unauthorized attempts (401 errors)
# 5. Use VPN for remote access instead of exposing directly
# 6. Set MCP_HOST=127.0.0.1 unless you need remote access
# 7. Always keep Node.js and dependencies updated
