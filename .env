# Revit MCP Server - Secure Configuration

# ========== PORT & HOST ==========
# Next.js runs on 3000, so MCP server uses 3001 locally
PORT=3001
MCP_HOST=127.0.0.1

# ========== CERTIFICATES ==========
CERT_PATH=./certs/server.crt
KEY_PATH=./certs/server.key

# ========== ENVIRONMENT ==========
NODE_ENV=production

# ========== SECURITY - API KEY AUTHENTICATION ==========
# GENERATED: c8e331f621c4e46b0be5c9d815a171a261ad2dacff7324cf737bb42442b0094d
MCP_API_KEY=c8e331f621c4e46b0be5c9d815a171a261ad2dacff7324cf737bb42442b0094d

# ========== SECURITY - IP WHITELIST ==========
ENABLE_IP_WHITELIST=false

# ========== RATE LIMITING ==========
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ========== CONNECTION MODE ==========
# LOCAL DEVELOPMENT: leave unset or set to "direct" — connects to Revit plugin via localhost:8080 socket
# RAILWAY/CLOUD: set to "relay" — routes tool calls through the cloud relay WebSocket to the Revit plugin
# REVIT_CONNECTION_MODE=relay
REVIT_CONNECTION_MODE=direct
