# Revit MCP Server Configuration
# Copy this to .env and fill in your values

# ─── Server Configuration ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
MCP_HOST=0.0.0.0
MCP_API_KEY=your_secret_api_key_here_64_chars_minimum
MCP_SERVER_URL=https://your-domain.railway.app

# ─── Revit Connection Mode ───────────────────────────────────────────────────
# Options: "direct" (local TCP socket) or "relay" (cloud relay)
REVIT_CONNECTION_MODE=relay

# For direct mode only (local development):
REVIT_HOST=127.0.0.1
REVIT_PORT=8080

# ─── Relay Server (for Railway deployment) ──────────────────────────────────
RELAY_URL=wss://your-domain.railway.app/relay
# Required for signed connection-scoped relay sessions (`dtm_rly_...`).
# Must be a long random secret and must stay private to the MCP service.
RELAY_SESSION_SECRET=generate_a_long_random_relay_session_secret_here

# ─── Timeouts ────────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=300000

# ─── Security & Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
ENABLE_IP_WHITELIST=false

# Optional IP Whitelist (comma-separated, only if ENABLE_IP_WHITELIST=true):
# IP_WHITELIST=127.0.0.1,192.168.1.100,10.0.0.1

# ─── SSL Certificates (for local HTTPS) ──────────────────────────────────────
# Railway provides HTTPS termination, so these are only for local testing
CERT_PATH=./certs/server.crt
KEY_PATH=./certs/server.key

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Options: debug, info, warn, error

# ─── Advanced (usually don't change) ──────────────────────────────────────────
PING_INTERVAL=30000
CLIENT_TIMEOUT=90000
MAX_PENDING_COMMANDS=100
