# Revit MCP Server Configuration
# Cloud Run injects these values directly. For local development, copy this
# file to .env and fill in the secrets.

# ─── Server Configuration ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
MCP_HOST=0.0.0.0
MCP_API_KEY=your_secret_api_key_here_64_chars_minimum
# Cloud Run primary:
MCP_SERVER_URL=https://datum-revit-mcp-PROJECT_HASH.us-east1.run.app
# Railway fallback:
# MCP_SERVER_URL=https://your-domain.railway.app

# ─── Revit Connection Mode ───────────────────────────────────────────────────
# Options: "direct" (local TCP socket) or "relay" (cloud relay)
REVIT_CONNECTION_MODE=relay

# For direct mode only (local development):
REVIT_HOST=127.0.0.1
REVIT_PORT=8080

# ─── Relay Server ─────────────────────────────────────────────────────────────
# Cloud Run primary:
RELAY_URL=wss://datum-revit-mcp-PROJECT_HASH.us-east1.run.app/relay
# Railway fallback:
# RELAY_URL=wss://your-domain.railway.app/relay
# Required for signed connection-scoped relay sessions (`dtm_rly_...`).
# Must be a long random secret and must stay private to the MCP service.
RELAY_SESSION_SECRET=generate_a_long_random_relay_session_secret_here

# ─── HTTP Timeouts ────────────────────────────────────────────────────────────
# Keep these below the Cloud Run request timeout configured during deployment.
SERVER_TIMEOUT_MS=660000
SERVER_KEEPALIVE_TIMEOUT_MS=665000
SERVER_HEADERS_TIMEOUT_MS=670000

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Options: debug, info, warn, error
