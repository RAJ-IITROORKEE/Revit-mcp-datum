{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.datumm.com/desktop-bridge/v1/bridge-command.json",
  "title": "Datumm Bridge Command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "type",
    "commandId",
    "jobId",
    "connectionId",
    "revitInstanceId",
    "routeGeneration",
    "leaseEpoch",
    "documentFingerprint",
    "tool",
    "args",
    "deadlineUnixMs",
    "mutationClass"
  ],
  "properties": {
    "protocolVersion": { "const": 1 },
    "type": { "const": "command" },
    "commandId": { "type": "string", "minLength": 16, "maxLength": 128 },
    "jobId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "connectionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "revitInstanceId": { "type": "string", "minLength": 16, "maxLength": 128 },
    "routeGeneration": { "type": "integer", "minimum": 1 },
    "leaseEpoch": { "type": "integer", "minimum": 1 },
    "documentFingerprint": { "type": "string", "minLength": 16, "maxLength": 256 },
    "tool": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,127}$" },
    "args": {},
    "deadlineUnixMs": { "type": "integer", "minimum": 0 },
    "mutationClass": {
      "enum": ["read", "idempotent_mutation", "mutation", "unknown"]
    },
    "idempotencyKey": { "type": "string", "minLength": 16, "maxLength": 128 }
  },
  "allOf": [
    {
      "if": {
        "required": ["mutationClass"],
        "properties": {
          "mutationClass": { "enum": ["idempotent_mutation", "mutation"] }
        }
      },
      "then": { "required": ["idempotencyKey"] }
    }
  ]
}
