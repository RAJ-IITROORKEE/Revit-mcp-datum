{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.datumm.com/desktop-bridge/v2/bridge-response.json",
  "title": "Datumm Local Revit Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "type", "commandId", "jobId", "runtimeId", "connectionId", "revitInstanceId", "routeGeneration", "leaseEpoch", "stateVersion", "documentFingerprint", "payloadHash", "mutationClass", "journalState", "outcome"],
  "properties": {
    "protocolVersion": { "const": 2 },
    "type": { "const": "response" },
    "commandId": { "type": "string", "minLength": 16, "maxLength": 128 },
    "jobId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "runtimeId": { "type": "string", "minLength": 16, "maxLength": 128 },
    "connectionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "revitInstanceId": { "type": "string", "minLength": 16, "maxLength": 128 },
    "routeGeneration": { "type": "integer", "minimum": 1 },
    "leaseEpoch": { "type": "integer", "minimum": 1 },
    "stateVersion": { "type": "integer", "minimum": 1 },
    "documentFingerprint": { "type": "string", "minLength": 16, "maxLength": 256 },
    "payloadHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mutationClass": { "enum": ["read", "mutation", "dangerous"] },
    "journalState": { "enum": ["ACCEPTED", "DISPATCHED", "TERMINAL"] },
    "outcome": { "enum": ["NOT_DISPATCHED", "DISPATCHED", "COMPLETED", "FAILED_DEFINITIVE", "OUTCOME_UNKNOWN", "CANCELLED_BEFORE_DISPATCH", "RECOVERY_REQUIRED"] },
    "result": {},
    "createdElementIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "retryable": { "type": "boolean" }
      }
    },
    "durationMs": { "type": "integer", "minimum": 0 },
    "journalEvidenceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "enum": ["COMPLETED", "FAILED_DEFINITIVE", "RECOVERY_REQUIRED"] } }, "required": ["outcome"] },
      "then": { "properties": { "journalState": { "const": "TERMINAL" } }, "required": ["journalEvidenceHash"] }
    },
    {
      "if": { "properties": { "outcome": { "enum": ["DISPATCHED", "OUTCOME_UNKNOWN"] } }, "required": ["outcome"] },
      "then": { "properties": { "journalState": { "const": "DISPATCHED" } }, "required": ["journalEvidenceHash"] }
    },
    {
      "if": { "properties": { "outcome": { "enum": ["NOT_DISPATCHED", "CANCELLED_BEFORE_DISPATCH"] } }, "required": ["outcome"] },
      "then": { "properties": { "journalState": { "const": "ACCEPTED" } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "OUTCOME_UNKNOWN" } }, "required": ["outcome"] },
      "then": { "required": ["error"], "properties": { "error": { "type": "object", "properties": { "retryable": { "const": false } } } } }
    }
  ]
}
