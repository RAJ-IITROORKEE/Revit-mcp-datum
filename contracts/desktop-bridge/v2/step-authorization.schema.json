{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.datumm.com/desktop-bridge/v2/step-authorization.json",
  "title": "Datumm Signed Step Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["algorithm", "issuer", "kid", "jti", "userSubject", "desktopDeviceId", "runtimeId", "jobId", "revitInstanceId", "documentFingerprint", "leaseEpoch", "executionSnapshotId", "executionSnapshotHash", "planId", "planRevision", "planFingerprint", "stepId", "tool", "payloadHash", "issuedAt", "expiresAt", "signature"],
  "properties": {
    "algorithm": { "const": "Ed25519" },
    "issuer": { "const": "https://www.datumm.ai" },
    "kid": { "type": "string", "minLength": 8, "maxLength": 128 },
    "jti": { "type": "string", "minLength": 16, "maxLength": 128 },
    "userSubject": { "type": "string", "minLength": 1, "maxLength": 128 },
    "desktopDeviceId": { "type": "string", "minLength": 8, "maxLength": 128 },
    "runtimeId": { "type": "string", "minLength": 16, "maxLength": 128 },
    "jobId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "revitInstanceId": { "type": "string", "minLength": 16, "maxLength": 128 },
    "documentFingerprint": { "type": "string", "minLength": 16, "maxLength": 256 },
    "leaseEpoch": { "type": "integer", "minimum": 1 },
    "executionSnapshotId": { "type": "string", "minLength": 16, "maxLength": 128 },
    "executionSnapshotHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "planId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "planRevision": { "type": "integer", "minimum": 1 },
    "planFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stepId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tool": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,127}$" },
    "payloadHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{32,512}$" }
  }
}
