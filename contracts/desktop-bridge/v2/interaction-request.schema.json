{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.datumm.com/desktop-bridge/v2/interaction-request.json",
  "title": "Datumm Question or Permission Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "requestId", "jobId", "kind", "category", "question", "options", "createdAt", "expiresAt"],
  "properties": {
    "protocolVersion": { "const": 2 },
    "requestId": { "type": "string", "minLength": 16, "maxLength": 128 },
    "jobId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "kind": { "enum": ["question", "permission"] },
    "category": { "enum": ["design_clarification", "units_orientation", "plan_revision", "family_choice", "destructive_change", "dynamic_code", "recovery_rollback"] },
    "runtimeId": { "type": "string", "minLength": 16, "maxLength": 128 },
    "stateVersion": { "type": "integer", "minimum": 1 },
    "leaseEpoch": { "type": "integer", "minimum": 1 },
    "revitInstanceId": { "type": "string", "minLength": 16, "maxLength": 128 },
    "documentFingerprint": { "type": "string", "minLength": 16, "maxLength": 256 },
    "tool": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,127}$" },
    "payloadHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "planId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "planRevision": { "type": "integer", "minimum": 1 },
    "planFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "value": { "type": "string", "minLength": 1, "maxLength": 200 },
          "recommended": { "type": "boolean" },
          "destructive": { "type": "boolean" }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "permission" } }, "required": ["kind"] },
      "then": { "required": ["runtimeId", "stateVersion", "leaseEpoch", "revitInstanceId", "documentFingerprint", "tool", "payloadHash", "planId", "planRevision", "planFingerprint"] }
    },
    {
      "if": { "properties": { "category": { "enum": ["destructive_change", "dynamic_code", "recovery_rollback"] } }, "required": ["category"] },
      "then": {
        "properties": { "kind": { "const": "permission" } },
        "required": ["runtimeId", "stateVersion", "leaseEpoch", "planId", "planRevision", "planFingerprint"]
      }
    },
    {
      "if": { "properties": { "category": { "enum": ["design_clarification", "units_orientation", "plan_revision", "family_choice"] } }, "required": ["category"] },
      "then": { "properties": { "kind": { "const": "question" } } }
    }
  ]
}
